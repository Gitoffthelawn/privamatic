<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Widget colors – light mode static fallback (API 26–30).
         Uses app brand colours: BritishRacingGreen background (#004225) with
         Cream text (#FFFDD0) so the widget always matches the app theme on
         devices that do not support Material You (API 31+).
         API 31+ widgets use layout-v31/widget_privacy.xml which references
         @android:color/system_* dynamic colour tokens directly. -->

    <color name="widget_background">#004225</color>        <!-- BritishRacingGreen from Color.kt -->
    <color name="widget_primary_text">#FFFDD0</color>      <!-- Cream from Color.kt -->
    <color name="widget_secondary_text">#FFFDD0</color>    <!-- Cream from Color.kt -->
    <color name="widget_divider">#FFFDD0</color>           <!-- Cream from Color.kt (icon tint) -->

    <!-- No-background style (widget_privacy_no_background), all API levels: light text with a
         dark shadow, like launcher labels. Score and change tints are set in code (WidgetStyle). -->
    <color name="widget_no_background_text">#FFFFFF</color>
    <color name="widget_text_shadow">#CC000000</color>
    <color name="widget_icon_outline">#B3000000</color>
    <!-- Halo behind each text (drawable/widget_text_halo): 65 % keeps every text and tint at 3:1
         or more on White, Black or a photo, also in the variant that doesn't match the wallpaper. -->
    <color name="widget_text_halo">#A6000000</color>
    <!-- Dark-text variant (widget_privacy_no_background_dark_text): when the wallpaper's colour
         hints ask for dark text, as Pixel Launcher reads them. -->
    <color name="widget_no_background_dark_text">#1C1B1F</color>
    <color name="widget_text_shadow_light">#CCFFFFFF</color>
    <color name="widget_icon_outline_light">#B3FFFFFF</color>
    <color name="widget_text_halo_light">#A6FFFFFF</color>
</resources>
