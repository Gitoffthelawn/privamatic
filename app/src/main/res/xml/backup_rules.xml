<?xml version="1.0" encoding="utf-8"?><!--
   Android 11 and lower (ignored on 12+, where data_extraction_rules.xml applies).
   allowBackup="false" already stops backup there; these excludes are a second layer in case
   a device or transport ignores it. No app data leaves the device
   (docs/specs/backup-exclusions.md). Each domain is walked separately: excluding "root"
   doesn't cover the others.
   See https://developer.android.com/identity/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
    <exclude domain="device_root" path="."/>
    <exclude domain="device_file" path="."/>
    <exclude domain="device_database" path="."/>
    <exclude domain="device_sharedpref" path="."/>
</full-backup-content>
