<?xml version="1.0" encoding="utf-8"?>
<!-- No-background style on a wallpaper whose colour hints ask for dark text (API 31+,
     WallpaperColors.HINT_SUPPORTS_DARK_TEXT), as Pixel Launcher does for its labels: dark text
     with a light shadow, each text on a light halo (drawable/widget_text_halo_light) so it stays
     readable on a dark wallpaper until the next update picks the other variant. No
     widget_background view, so no alpha call goes to this layout. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The released (v1.5.1) layout: device block at the start, the shield centred, score and
         rating centred in the end half, the change at the end edge, centred on both rows.
         While a change shows, the score row reserves the change's width on both sides with an
         invisible copy of its text (widget_delta_space_*), so score and rating stay centred and
         never run under the change. If they are too wide for that they move towards the shield
         first and ellipsize only after. The row lays out in the reversed direction so the copy at
         the end edge is measured before the text and the copy at the shield after it. -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Shield icon at horizontal center; declared first so other views can anchor to it. -->
        <ImageView
            android:id="@+id/widget_divider"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_widget_shield_no_background_dark_text"
            android:contentDescription="@null" />

        <!-- Zero-height anchor at the exact vertical center of the widget.
             Both text columns position relative to this point so the combined
             two-line block is geometrically centered, not just one row. -->
        <TextView
            android:id="@+id/widget_center_anchor"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_centerInParent="true"
            android:text="" />

        <!-- OS name: just below the center anchor; the rating shares its baseline. The wrapper
             spans the start half, so the text (and its halo) keeps its own width. -->
        <LinearLayout
            android:id="@+id/widget_os_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/widget_divider"
            android:layout_below="@id/widget_center_anchor"
            android:layout_marginStart="8dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="12dp"
            android:baselineAlignedChildIndex="0"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_os_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GrapheneOS"
                android:textColor="@color/widget_no_background_dark_text"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:shadowColor="@color/widget_text_shadow_light"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:background="@drawable/widget_text_halo_light"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </LinearLayout>

        <!-- Device name: just above the center anchor. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/widget_divider"
            android:layout_above="@id/widget_center_anchor"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="1dp"
            android:layout_marginEnd="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pixel 9"
                android:textColor="@color/widget_no_background_dark_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:shadowColor="@color/widget_text_shadow_light"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:background="@drawable/widget_text_halo_light"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </LinearLayout>

        <!-- Score and rating, centred in the end half; the rating's baseline is the OS name's. -->
        <LinearLayout
            android:id="@+id/widget_score_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/widget_divider"
            android:layout_alignParentEnd="true"
            android:layout_alignBaseline="@id/widget_os_row"
            android:layoutDirection="@integer/widget_reversed_layout_direction"
            android:baselineAligned="false"
            android:baselineAlignedChildIndex="1"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <!-- Space the change takes at the end edge: measured first, never shrinks. -->
            <TextView
                android:id="@+id/widget_delta_space_end"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:textSize="18sp"
                android:maxLines="1"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <!-- Score centred above the rating; reports the rating's baseline. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layoutDirection="locale"
                android:baselineAlignedChildIndex="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_score_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="85"
                    android:textColor="@color/widget_no_background_dark_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:shadowColor="@color/widget_text_shadow_light"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="6"
                    android:background="@drawable/widget_text_halo_light"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <TextView
                    android:id="@+id/widget_score_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/score_rating_excellent_name"
                    android:textColor="@color/widget_no_background_dark_text"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:shadowColor="@color/widget_text_shadow_light"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="6"
                    android:background="@drawable/widget_text_halo_light"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />
            </LinearLayout>

            <!-- The same space on the shield side: measured last, shrinks first. -->
            <TextView
                android:id="@+id/widget_delta_space_shield"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:textSize="18sp"
                android:maxLines="1"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Change: "↑5" / "↓5", colour set in code (green for a rise, red for a drop). At the end
             edge, centred on the score and rating; the wrapper lets the text keep its own size. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_alignTop="@id/widget_score_row"
            android:layout_alignBottom="@id/widget_score_row"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_score_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_no_background_dark_text"
                android:textSize="18sp"
                android:maxLines="1"
                android:shadowColor="@color/widget_text_shadow_light"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:background="@drawable/widget_text_halo_light"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
