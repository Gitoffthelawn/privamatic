<?xml version="1.0" encoding="utf-8"?>
<!-- API 26–30 fallback layout: uses static colors from @color/widget_* resources.
     The -night resource qualifier in values-night/colors.xml handles dark mode
     without requiring a DayNight theme.
     API 31+ devices use layout-v31/widget_privacy.xml instead. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background layer: opacity is applied only to this view so text/icons stay crisp.
         Uses ImageView because RemoteViews only supports a limited set of view types. -->
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <!-- Two columns around the shield. Score and change share one row, and the change
         auto-sizes into the space left, so the two never overlap at large font scales. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pixel 9"
                android:textColor="@color/widget_primary_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_os_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GrapheneOS"
                android:textColor="@color/widget_secondary_text"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_divider"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_widget_shield"
            android:tint="@color/widget_divider"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_score_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85"
                    android:textColor="@color/widget_primary_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Colour set in code: green for a rise, red for a drop. -->
                <TextView
                    android:id="@+id/widget_score_delta"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical|start"
                    android:textColor="@color/widget_primary_text"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeStepGranularity="1sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_score_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/score_rating_excellent_name"
                android:textColor="@color/widget_secondary_text"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
